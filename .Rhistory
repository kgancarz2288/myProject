source("~/myProject/scripts/visualize_trees.R")
conda install -c bioconda -c conda-forge raxml-ng
q()
library(treeio)
library(ggtree)
library(ape)
library(phytools)
library(phangorn)
library(ggplot2)
library(patchwork)
BiocManager::install("ggtree", force=TRUE)
library(ggtree)
library(ape)
library(phytools)
library(phangorn)
library(ggplot2)
library(patchwork)
raxml_td <- read.tree("~/myProject/results/raxml/raxml_tree.raxml.bestTree")
iq_td <- read.tree("~/myProject/results/iqtree_mafft/mafft_tree.contree")
plot(raxml_td)
nodelabels()
raxml_rooted <- root(raxml_td, node=70, resolve.root=TRUE)
plot(raxml_rooted)
plot(iq_td)
nodelabels()
iq_rooted <- root(iq_td, outgroup="Anolis_carolinensis", resolve.root=TRUE)
plot(iq_rooted)
p1 <- ggtree(raxml_rooted) +
  geom_tiplab(size = 2) +
  ggtitle("RAxML Tree")

p2 <- ggtree(iq_rooted) +
  geom_tiplab(size = 2) +
  ggtitle("IQ-TREE Tree")

p1 + p2 + plot_layout(ncol = 2)
comparePhylo(raxml_rooted, iq_rooted)
raxml_rooted$node.label
iq_rooted$node.label
iq_td2 <- read.iqtree("~/myProject/results/iqtree_mafft/mafft_tree.contree")
iq_phy <- as.phylo(iq_td2)
iq_rooted2 <- root(iq_phy, outgroup="Anolis_carolinensis", resolve.root=TRUE)
iq_rooted2$node.label
png("~/myProject/results/trees_comparison.png", width=1200, height=800)
p1 + p2 + plot_layout(ncol=2)
dev.off()
cd ~/myProject
echo "## $(date)" >> log.md
echo "- Visualized and compared RAxML and IQ-TREE trees using ggtree" >> log.md
git add .
git commit -m "Added tree visualization and comparison results"
git push
cd ~/myProject
q()
